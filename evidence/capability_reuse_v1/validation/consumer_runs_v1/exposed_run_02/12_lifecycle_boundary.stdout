    "passages": [
      {
        "target": "acquisition-passage:qatr_wasl_fatha",
        "span_sha256": "cdbc6158da8f94721c1f7fd32ae296942e116958644ff0d0f45be7b8f945561f",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 39574,
        "byte_end": 40168,
        "line_start": 449,
        "line_end": 453,
        "raw_text": "# فصل: همزة اسم بكسر وضم، واست ابن وابنم وابنة وامرئ وامرأة وتثنيتهن،\n~~واثنين واثنتين، والغلام وايمن الله في القسم بفتحهما، أو بكسر في ايمن:\n~~همزة وصل، أي تثبت ابتداء وتحذف وصلا وكذا همزة الماضي المتجاوز أربعة\n~~أحرف، ك \"استخرج\"، وأمره ومصدره، وأمر الثلاثي، ك\"اقتل واغز واغزي\" بضمهن،\n~~و \"اضرب وامشوا واذهب\" بكسر كالبواقي. PageV01P026 ms13"
      },
      {
        "target": "acquisition-passage:sibawayhi_article_initial_fatha",
        "span_sha256": "e4668fc08abec82373c833b8d4aaa320240e6d5023b16e25694c3307df5303df",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 2098432,
        "byte_end": 2100192,
        "line_start": 17540,
        "line_end": 17553,
        "raw_text": "# % ويلمها في هواء الجو طالبة % % ولا كهذا الذي في الأرض مطلوب % وتكون\n~~موصولة في الحرف الذي تعرف به الأسماء والحرف الذي تعرف به الأسماء هو\n~~الحرف الذي في قولك القوم والرجل والناس وإنما هما حرف بمنزلة قولك قد وسوف\n~~وقد بينا ذلك فيما ينصرف ومالا ينصرف | ألا ترى أن الرجل إذا نسي فتذكر ولم\n~~يرد أن يقطع يقول ألي كما يقول قدي ثم يقول كان وكان ولا يكون ذلك في ابن\n~~ولا امرئ لأن الميم ليست منفصلة ولا الباء | وقال غيلان\n# % دع ذا وعجل ذا وألحقنا بذل % بالشحم إنا قد مللناه بجل % كما تقول إنه\n~~قدي ثم تقول قد كان كذا وكذا فتثني قد ولكنه لم يكسر اللام في قوله بذل\n~~ويجيء بالياء لأن البناء قد تم PageV04P147 وزعم الخليل أنها مفصولة كقد\n~~وسوف ولكنها جاءت لمعنى كما ms743 يجيئان للمعاني فلما لم تكن الألف في فعل ولا\n~~اسم كانت في الابتداء مفتوحة فرق بينها وبين ما في الأسماء والأفعال وصارت\n~~في ألف الاستفهام إذا كانت قبلها لا تحذف شبهت بألف احمر لأنها زائدة وهي\n~~مفتوحة مثلها لأنها لما كانت في الابتداء مفتوحة كرهوا أن يحذفوها فيكون\n~~لفظ الاستفهام والخبر واحدا فأرادوا أن يفصلوا ويبينوا | ومثلها من ألفات\n"
      },
      {
        "target": "acquisition-passage:sibawayhi_connected_restart",
        "span_sha256": "c085d2a2f67a573d8b579eca9479bf2a90e84637500ceda5905e7de6a0a4d138",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 2102704,
        "byte_end": 2103502,
        "line_start": 17575,
        "line_end": 17581,
        "raw_text": "~~ثابتة كالرفعة في نون ابن لأنها ضمة إنما تكون في حال الرفع | واعلم أن هذه\n~~الألفات ألفات الوصل تحذف جميعا إذا كان قبلها كلام إلا ما ذكرنا من الألف\n~~واللام في الاستفهام وفي أيمن في باب القسم لعلة قد ذكرناها فعل ذلك بها في\n~~باب القسم حيث كانت مفتوحة قبل الاستفهام فخافوا أن تلتبس الألف بألف\n~~الاستفهام وتذهب في غير ذلك إذا كان قبلها كلام إلا أن تقطع كلامك وتستأنف\n~~كما قالت الشعراء في الأنصاف لأنها مواضع فصول فإنما ابتدءوا بعد قطع قال\n~~الشاعر\n"
      },
      {
        "target": "acquisition-passage:sibawayhi_sukun_contact",
        "span_sha256": "8b200bf3df77bdd992384b604f10bd41dfac26bc8dbbe83505f48e9503b89f80",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 2105028,
        "byte_end": 2106050,
        "line_start": 17595,
        "line_end": 17603,
        "raw_text": "# | ( هذا باب تحرك أواخر الكلم الساكنة إذا حذفت ألف الوصل لالتقاء\n~~الساكنين )\n# وإنما حذفوا ألف الوصل هاهنا بعد الساكن لأن من كلامهم أن يحذف وهو بعد\n~~غير الساكن فلما كان ذلك من كلامهم ms745 حذفوها ههنا وجعلوا التحرك للساكنة\n~~الأولى حيث لم يكن ليلتقي ساكنان وجعلوا هذا سبيلها ليفرقوا بينها وبين\n~~الألف المقطوعة فجملة هذا الباب في التحرك أن يكون الساكن الأول مكسورا\n~~وذلك قولك اضرب ابنك وأكرم الرجل واذهب اذهب و @QB@ قل هو الله أحد الله\n~~@QE@ لأن التنوين ساكن وقع بعده حرف ساكن فصار بمنزلة باء اضرب ونحو ذلك |\n~~ومن ذلك إن الله عافاني فعلت وعن الرجل وقط الرجل ولو استطعنا | ونظير\n"
      },
      {
        "target": "acquisition-passage:sibawayhi_long_vowel_contact",
        "span_sha256": "5530adb2500c6c29f3221cad05e40bd56508dbab00957643b6bd19d4aa00bc13",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 2110831,
        "byte_end": 2111813,
        "line_start": 17643,
        "line_end": 17650,
        "raw_text": "# | ( هذا باب ما يحذف من السواكن إذا وقع بعدها ساكن )\n# وذلك ثلاثة أحرف الألف والياء التي قبلها حرف مكسور والواو التي قبلها\n~~حرف مضموم | فأما حذف الألف فقولك رمى الرجل وأنت تريد رمي ولم يخف وإنما\n~~كرهوا تحريكها لأنها إذا حركت صارت ياء أو واوا فكرهوا ms747 أن تصير إلى ما\n~~يستثقلون فحذفوا الألف حيث لم يخافوا التباسا | ومثل ذلك هذه حبلى الرجل\n~~ومعزى القوم وأنت تريد المعزى والحبلى كرهوا أن يصيروا إلى ما هو أثقل من\n~~الألف فحذفوا حيث لم يخافوا التباسا | ومثل ذلك قولهم رمت وقالوا رميا\n~~فجاءوا بالياء وقالوا غزوا فجاءوا بالواو لئلا يلتبس الاثنان بالواحد\n"
      },
      {
        "target": "acquisition-passage:sibawayhi_article_sun",
        "span_sha256": "111540a27bb05ca13a3a988232e81983ee39b9b73e426bbcfbc32b4398b71d18",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 2593814,
        "byte_end": 2595091,
        "line_start": 21531,
        "line_end": 21540,
        "raw_text": "~~مخرجه عنها ولم ms913 يوافقها إلا في الغنة PageV04P456 ولام المعرفة تدغم في\n~~ثلاثة عشرة حرفا لا يجوز فيها معهن إلا الإدغام وكثرة موافقتها لهذه الحروف\n~~من طرف اللسان وهذه الحروف أحد عشر حرفا منها حروف طرف اللسان وحرفان\n~~خالطان حرف اللسان فلما اجتمع فيها هذا وكثرتها في الكلام لم يجز إلا\n~~الإدغام كما لم يجز في يرى إذ كثر في الكلام وكانت الهمزة تستثقل إلا الحذف\n~~ولو كانت ينأى وينأل لكنت بالخيار | والأحد عشر حرفا النون والراء والدال\n~~والتاء والصاد والطاء والزاي والسين والظاء والثاء والذال | واللذان\n~~خالطاها الضاد والشين لأن الضاد استطالت لرخاوتها حتى اتصلت بمخرج اللام\n~~والشين كذلك حتى اتصلت بمخرج الطاء | وذلك قولك النعمان والرجل وكذلك سائر\n~~هذه الحروف | فإذا كانت غير لام المعرفة نحو لام هل وبل فإن الإدغام في\n"
      },
      {
        "target": "acquisition-passage:sibawayhi_article_lam_shown",
        "span_sha256": "24a6ac58b10d29e71cbacbe5643e5fa1eb4995dec5c8248de571372557cf74a9",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 2638399,
        "byte_end": 2639295,
        "line_start": 21886,
        "line_end": 21892,
        "raw_text": "~~مكانها كما تبدل هي مكانها في الإطباق | ومن الشاذ ms928 قولهم في بني العنبر\n~~وبني الحارث بالعنبر وبالحارث بحذف النون | وكذلك يفعلون بكل قبيلة تظهر\n~~فيها لام المعرفة | فأما إذا لم تظهر اللام فيها فلا يكون ذلك لأنها لما\n~~كانت مما كثر في كلامهم وكانت اللام والنون قريبتي المخارج حذفوها وشبهوها\n~~بمست لأنهما حرفان متقاربان ولم يصلوا إلى الإدغام كما لم يصلوا في مسست\n~~لسكون اللام وهذا أبعد لأنه اجتمع فيه أنه منفصل وأنه ساكن لا يتصرف تصرف\n~~الفعل حيث تدركه الحركة PageV04P484 ومثل هذا قول بعضهم علماء بنو فلان\n"
      },
      {
        "target": "acquisition-passage:sibawayhi_haqq_article",
        "span_sha256": "40f87b59c40a7aab749002e50ae477019ba368ef8c6a26eb836339b68a600e5b",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 440653,
        "byte_end": 442968,
        "line_start": 3757,
        "line_end": 3775,
        "raw_text": "# | ( هذا باب ما ينتصب من المصادر توكيدا لما قبله )\n# | وذلك قولك هذا عبد الله حقا وهذا زيد الحق لا الباطل وهذا زيد غبر ما\n~~تقول | وزعم الخليل رحمه الله أن قوله هذا القول لا قولك إنما نصبه كنصب\n~~غير ما تقول لأن لا قولك فى ذلك المعنى | ألا ترى أنك تقول هذا القول لا ما\n~~تقول فهذا فى موضع نصب | فإذا قلت لا قولك فهو فى موضع لا ما تقول\n~~PageV01P378 | ومثل ذلك فى الاستفهام أجدك لا تفعل كذا وكذا ؟ كأنه قال\n~~أحقا لا تفعل كذا وكذا ؟ وأصله من الجد كأنه قال أجدا ولكنه لا يتصرف ولا\n~~يفارقه الإضافة كما كان ذلك في لبيك ومعاذ الله | وأما غير ما تقول فلا\n~~تعرى من أن تكون فى هذا الموضع مضافة إلى اسم معروف نحو قولك لأنه لو قال\n~~غير قول أو لا قولا لم يكن فى هذا بيان لأنه ليس كل قول باطلا وإنما يريد\n~~أن يحقق الأول بأمر معروف | ولو قال هذا الأمر غير قيل باطل كان حسنا لأنه\n~~قد وكد أول كلامه بأمر معروف وقد اختصه فصار بمنزلة قولك لا قولك حين جعله\n~~مضافا لأنك قد اختصصته من جميع القول بإضافتك وأنه يسوغ أن يكون قوله باطلا\n~~ولا يسوغ أن يكون جميع الأقوال باطلا | ومن ذلك قولك قد قعد البتة ولا\n~~يستعمل إلا معرفة بالألف واللام كما أن جهدك وأجهدك لا يستعملان إلا معرفة\n~~بالإضافة | وأما الحق والباطل فيكونان معرفة بالألف واللام ونكرة لأنهما لم\n~~PageV01P379 ينزلا منزلة ما لم يتمكن من المصادر كسبحان وسعديك ولكنهم\n~~أنزلوهما منزلة الظن وكذلك اليقين لأنك تحقق به كما تفعل ذلك بالحق | فأنزل\n~~ما ذكرنا غير هذا بمنزلة عمرك الله وقعدك الله\n"
      },
      {
        "target": "acquisition-passage:mukhtar_labis_counterexample",
        "span_sha256": "301842a823d30262ad551411ec1bdc077bd26628a6d7cac84d5e843d4625f4a4",
        "kind": "passage_quotation",
        "source_id": "mukhtar_sihah",
        "source_revision": "e93f4054f3cddb826a7b3fafd01eac8c4b39b25ed2d92ece7ea093b755776691",
        "byte_start": 1228203,
        "byte_end": 1228720,
        "line_start": 11100,
        "line_end": 11103,
        "raw_text": "# ل ب س لبس الثوب يلبسه بالفتح لبسا بالضم و لبس عليه الأمر خلط وبابه ضرب\n~~ومنه قوله تعالى @QB@ وللبسنا عليهم ما يلبسون @QE@ وفي الأمر لبسة بالضم\n~~أي شبهة يعني ليس بواضح و اللباس بالكسر ما يلبس وكذا الملبس بوزن المذهب و\n~~اللبس أيضا بوزن الدبس و لبس الكعبة أيضا والهودج ما عليهما من لباس و لباس\n"
      },
      {
        "target": "acquisition-passage:mukhtar_laib_counterexample",
        "span_sha256": "7ef680e5f215fbe9e7a5382c71203f2fc5a5da2f0898674ad31b5f8f89c81061",
        "kind": "passage_quotation",
        "source_id": "mukhtar_sihah",
        "source_revision": "e93f4054f3cddb826a7b3fafd01eac8c4b39b25ed2d92ece7ea093b755776691",
        "byte_start": 1241741,
        "byte_end": 1242124,
        "line_start": 11222,
        "line_end": 11224,
        "raw_text": "# ل ع ب اللعب معروف و اللعب مثله و لعب من باب طرب و لعبا أيضا بوزن علم و\n~~تلعب أي لعب مرة بعد أخرى ورجل تلعابة بالكسر كثير اللعب و التلعاب بالفتح\n~~المصدر و لعاب النحل العسل و اللعاب ما يسيل من الفم و لعب الصبي من باب\n"
      },
      {
        "target": "acquisition-passage:qatr_case_marks",
        "span_sha256": "c92b1a92de3fc298dd777a51b0983c3942ffbd8520d495cc68f5c60436639a8e",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 3959,
        "byte_end": 4370,
        "line_start": 75,
        "line_end": 78,
        "raw_text": "# فصل: أنواع الإعراب أربعة.\n# (1) رفع (2) ونصب في اسم وفعل نحو \"زيد يقوم\" و \"إن زيدا لن يقوم\"، (3)\n~~وجر في اسم نحو \"بزيد\"، (4) وجزم نحو \"لم يقم\". فيرفع بضمة، وينصب بفتحة،\n~~ويجر بكسرة، ويجزم بحذف حركة، إلا الأسماء الستة، وهي أبوه وأخوه وحموها\n"
      },
      {
        "target": "acquisition-passage:qatr_weak_imperative",
        "span_sha256": "2ffa1f8ea709fb84c320ee712cc6c8ffaca468b8e21077e2e465ed770dde63dc",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 2558,
        "byte_end": 2945,
        "line_start": 59,
        "line_end": 63,
        "raw_text": "# وأمر: ويعرف بدلالته على الطلب مع قبوله ياء المخاطبة. وبناؤه على السكون\n~~ك\"اضرب\"، إلا المعتل فعلى حذف آخره ك\"اغز واخش وارم\"، ونحو قوما\n# PageV01P004\n# وقوموا وقومي فعلى حذف النون. ومنه هلم في لغة تميم، وهات وتعال في\n~~الأصح.\n"
      },
      {
        "target": "acquisition-passage:mukhtar_haqq",
        "span_sha256": "01b6a867fc74fb77551de1dfb09a3a3ff08e78eaf9851c787ef4a644acc3d2fb",
        "kind": "passage_quotation",
        "source_id": "mukhtar_sihah",
        "source_revision": "e93f4054f3cddb826a7b3fafd01eac8c4b39b25ed2d92ece7ea093b755776691",
        "byte_start": 315232,
        "byte_end": 315738,
        "line_start": 2937,
        "line_end": 2940,
        "raw_text": "# ح ق ق الحق ضد الباطل والحق أيضا واحد الحقوق و الحقة بالضم معروفة\n~~والجمع حق و حقق و حقاق و الحق بالسكر ما كان من الإبل بن ثلاث سنين وقد\n~~دخل في الرابعة والأنثى حقة و حق أيضا سمي بذلك لاستحقاقه أن يحمل عليه وأن\n~~ينتفع به والجمع حقاق ثم حقق بضمتين مثل كتاب وكتب و الحاقة القيامة سميت\n"
      },
      {
        "target": "acquisition-passage:mukhtar_ghulam",
        "span_sha256": "cdea1ea34baf37e700390079ac1f7038811f1b93627430cec0bd8287e39f64f1",
        "kind": "passage_quotation",
        "source_id": "mukhtar_sihah",
        "source_revision": "e93f4054f3cddb826a7b3fafd01eac8c4b39b25ed2d92ece7ea093b755776691",
        "byte_start": 1003721,
        "byte_end": 1003957,
        "line_start": 9096,
        "line_end": 9097,
        "raw_text": "# غ ل م الغلام معروف وجمعه غلمة و غلمان ويقال غلام بين الغلومة و\n~~الغلومية والأنثى غلامة قال يصف فرسا % تهان لها ms371 الغلامة والغلام\n"
      },
      {
        "target": "acquisition-passage:mukhtar_qawm",
        "span_sha256": "d22421193fa6337f822e82f67c68f7b9b0adb7170ec19c3955659ae0de8207f0",
        "kind": "passage_quotation",
        "source_id": "mukhtar_sihah",
        "source_revision": "e93f4054f3cddb826a7b3fafd01eac8c4b39b25ed2d92ece7ea093b755776691",
        "byte_start": 1161614,
        "byte_end": 1162486,
        "line_start": 10507,
        "line_end": 10513,
        "raw_text": "# ق و م القوم الرجال دون النساء لا واحدا له من لفظه قال زهير وما أدري\n~~ولست إخال أدري أقوم آل حصن أم نساء وقال الله تعالى @QB@ لا يسخر قوم من\n~~قوم @QE@ ثم قال @QB@ ولا نساء من نساء @QE@ وربما دخل النساء فيه على سبيل\n~~التبع لأن قوم كل نبي رجال ونساء وجمع القوم أقوام وجمع الجمع أقاوم و\n~~أقائم و القوم يذكر ويؤنث لان أسماء الجموع التي لا واحد لها من لفظها إذا\n~~كان للآدميين يذكر ويؤنث مثل الرهط ولانفر والقوم قال الله تعالى @QB@ وكذب\n~~به قومك @QE@ وقال @QB@ كذبت قوم نوح @QE@ و قام يقوم قياما و القومة المرة\n"
      },
      {
        "target": "acquisition-passage:mukhtar_laqiya",
        "span_sha256": "ab01c241af7774f711a9d6217a6100cf65c13730a16692c4af4830578dde9d0f",
        "kind": "passage_quotation",
        "source_id": "mukhtar_sihah",
        "source_revision": "e93f4054f3cddb826a7b3fafd01eac8c4b39b25ed2d92ece7ea093b755776691",
        "byte_start": 1249553,
        "byte_end": 1250448,
        "line_start": 11296,
        "line_end": 11302,
        "raw_text": "# ل ق ي لقيه لقاء بالكسر والمد و لقى بالضم والقصر و لقيا بالضم والتشديد\n~~و لقيانا و لقيانة واحدة بالضم فيهما و لقية واحدة بالفتح و لقاءة واحدة\n~~بالكسر والمد ولا تقل لقاة فإنها مولدة وليست من كلام العرب و ألقاه طرحه\n~~تقول ألقه من يدك وألق به من يدك و ألقى إليه المودة وبالمودة و التقوا و\n~~تلاقوا بمعنى و استلقى على قفاه و تلقاه أي استقبله وقوله تعالى @QB@ إذ\n~~تلقونه بألسنتكم @QE@ أي يأخذ بعض عن بعض وجلس تلقاءه أي حذاءه و التلقاء\n~~أيضا مصدر مثل اللقاء و اللقى بالفتح الشيء الملقى لهوانه و اللقوة داء في\n"
      },
      {
        "target": "acquisition-passage:mukhtar_walad_and_awlad",
        "span_sha256": "95ea2bcbc57169d4f12491aded00048c29a97ffe636394847ae60ac3bb576f7e",
        "kind": "passage_quotation",
        "source_id": "mukhtar_sihah",
        "source_revision": "e93f4054f3cddb826a7b3fafd01eac8c4b39b25ed2d92ece7ea093b755776691",
        "byte_start": 1518919,
        "byte_end": 1519575,
        "line_start": 13767,
        "line_end": 13771,
        "raw_text": "# و ل د الولد يكون واحدا وجمعا وكذا الولد بوزن القفل وقد يكون الولد جمع\n~~ولد كأسد وأسد و الولد بالكسر لغة في الولد و الوليد الصبي والعبد والجمع\n~~ولدان كصبيان و ولدة كصبية و الوليدة الصبية وا مة والجمع الولائد و ولدت\n~~المرأة أولادا و ولادة و أولدت حان ولادها ms562 و توالدوا أي كثروا وولد بعضهم\n~~بعضا و الوالد الأب و الوالدة الأم وهما الوالدان وشاة والد أي حامل و تولد\n"
      },
      {
        "target": "acquisition-passage:sibawayhi_awlad_occurrence",
        "span_sha256": "cbb6e06209a2db5db2214d71c16773b8c1869a9ba8bdf5ea76e7b625837d5949",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 245514,
        "byte_end": 246028,
        "line_start": 2112,
        "line_end": 2115,
        "raw_text": "~~من الاتساع والإيجاز فتقول صيد عليه يومان | وإنما المعنى صيد عليه ms087 الوحش\n~~فى يومين ولكنه اتسع واختصر | ولذلك أيضا وضع السائل كم غير ظرف | ومن ذلك\n~~أن تقول كم ولد له ؟ فيقول ستون عاما | فالمعنى ولد له الأولاد وولد له\n~~الولد ستين عاما ولكنه اتسع وأوجز | ومن ذلك أن تقول كم سير عليه وكم غير\n"
      },
      {
        "target": "acquisition-passage:qatr_dual_plural_endings",
        "span_sha256": "418e0175afa9c144cc6ad0b156c094f914dac15097f7b7a0e740198b6c8835d6",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 4538,
        "byte_end": 5139,
        "line_start": 82,
        "line_end": 86,
        "raw_text": "# والمثنى ms01 كالزيدان فيرفع بالألف، وجمع المذكر السالم كالزيدون فيرفع\n~~بالواو، ويجران وينصبان بالياء. وكلا وكلتا مع الضمير كالمثنى، وكذا اثنان\n~~واثنتان مطلقا وإن ركبا وأولو وعشرون وأخواته وعالمون وأهلون ووابلون\n~~وأرضون وسنون وبابه وبنون وعليون وشبهه كالجمع.\n# وأولات وما جمع بألف وتاء مزيدتين وما سمي به منهما فينصب بالكسرة، نحو\n"
      },
      {
        "target": "acquisition-passage:qatr_qumt_pronoun",
        "span_sha256": "ce164bf8fc1d1e054abf68fe4f3428c1fd479014d0b33fd8aa568a82cd2cee1d",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 8903,
        "byte_end": 9405,
        "line_start": 123,
        "line_end": 126,
        "raw_text": "# نكرة، وهو ما شاع في جنس موجود ك\"رجل\" أو مقدر ك\"شمس\"، ومعرفة وهي ستة:\n~~الضمير وهو ما دل على متكلم أو مخاطب أو غائب. وهو إما مستتر كالمقدر وجوبا\n~~في نحو \"أقوم\" و \"تقوم\" أو جوازا فشي نحو \"زيد يقوم\"، أو بارز وهو إما متصل\n~~ك\"تاء\" \"قمت\" وكاف \"أكرمك\" وهاء \"غلامه\"، أو منفصل ك\"أنا وأنت وإياي\". ولا\n"
      },
      {
        "target": "acquisition-passage:sabban_ta_person",
        "span_sha256": "3629aa0e5d61e288febb60990e8f3a381c22033bdbf92d8f6b1aaa44d9755eff",
        "kind": "passage_quotation",
        "source_id": "sabban",
        "source_revision": "8b9e86da786cf65e7b32498b2524ee48a8dcf9f61b59e1bbc32b99ce7db5b396",
        "byte_start": 708697,
        "byte_end": 709874,
        "line_start": 6186,
        "line_end": 6194,
        "raw_text": "# قوله: \"كالياء والكاف إلخ\" أشار بتعداد الأمثلة إلى أنواع الضمير الثلاثة\n~~المتكلم والمخاطب والغائب ومحاله الثلاثة الرفع والنصب والجر والمقصود بذكر\n~~ياء وهاء سليه التمثيل للمرفوع وللغائب لا المخاطب والمنصوب لحصولهما\n~~بالكاف من أكرمك ومن المتصل المرفوع تاء تضم للمتكلم وتفتح للمخاطب وتكسر\n~~للمخاطبة للفرق وخصوا المتكلم بالضمة لتقدم مرتبته فأعطى أشرف الحركات\n~~والمخاطب المذكر بالفتح لأن خطابه أكثر من خطاب المؤنث فالتخفيف به أولى\n~~وأيضا هو مقدم على المؤنث فأعطى التخفيف فلم يبق للمؤنث إلا الكسر وحكى\n~~بعضهم أن وصل فتحة تاء الضمير وكافه بألف وكسرتهما بياء لغة رديئة لربيعة\n~~فيجوز عليها قمتا ورأيتكا وقمتي ورأيتكي وتوصل التاء المذكورة مضمومة بميم\n"
      },
      {
        "target": "acquisition-passage:ibn_aqil_dhahib",
        "span_sha256": "7bd5052425aef0f210c67c56b6f7f142d8e7161c95042c141396b254344931c6",
        "kind": "passage_quotation",
        "source_id": "ibn_aqil",
        "source_revision": "661e43ea265eca8c72b9e4ab7a46cd9182b34e834105b595241bc7787b471f09",
        "byte_start": 539657,
        "byte_end": 540368,
        "line_start": 5653,
        "line_end": 5658,
        "raw_text": "# كفاعل صغ اسم فاعل إذا ... من ذى ثلاثة يكون كغذا\n# إذا أريد بناء اسم الفاعل من الفعل الثلاثي جيء به على مثال فاعل وذلك\n~~مقيس في كل فعل كان على وزن فعل بفتح العين متعديا كان أو لازما نحو ضرب\n~~فهو ضارب وذهب فهو ذاهب وغذا فهو غاذ فإن كان الفعل على وزن فعل بكسر العين\n~~فإما أن يكون متعديا أو لازما فإن كان متعديا فقياسه أيضا أن يأتي اسم\n~~فاعله على فاعل نحو ركب فهو راكب وعلم فهو عالم وإن كان لازما أو كان\n"
      },
      {
        "target": "acquisition-passage:natural_eye_senses",
        "span_sha256": "0102881b6f3c82377e358f146bb7b654436c3ac22c51ddc8415046ee6cd328d9",
        "kind": "passage_quotation",
        "source_id": "linguistic_inventory",
        "source_revision": "78ed6b6b25c3b6ec2a2b397a29338d8c4598de852ebe1ef1f06005bab990383b",
        "byte_start": 23851,
        "byte_end": 23924,
        "line_start": null,
        "line_end": null,
        "raw_text": "مثل لفظ العين للباصرة، والجارية، والذهب"
      },
      {
        "target": "acquisition-passage:natural_eye_definition",
        "span_sha256": "90c818767a50f83bedaff3d596a7879bfb4a6bba99a021dc99c019a8d2052866",
        "kind": "passage_quotation",
        "source_id": "maqayis",
        "source_revision": "7f71af0dfe056cb84e7da24657fa13edc6e8061ca1980eed7f6c196bd18b5689",
        "byte_start": 2420979,
        "byte_end": 2421086,
        "line_start": null,
        "line_end": null,
        "raw_text": "العين والياء والنون أصل واحد صحيح يدل على عضو به يبصر وينظر"
      },
      {
        "target": "acquisition-passage:natural_spring_definition",
        "span_sha256": "309f01952c8644557ab3ce774a181ec97c244dd6b21ac4e178cf3f25ac74b767",
        "kind": "passage_quotation",
        "source_id": "maqayis",
        "source_revision": "7f71af0dfe056cb84e7da24657fa13edc6e8061ca1980eed7f6c196bd18b5689",
        "byte_start": 2423390,
        "byte_end": 2423473,
        "line_start": null,
        "line_end": null,
        "raw_text": "ومن الباب العين الجارية النابعة من عيون الماء"
      },
      {
        "target": "acquisition-passage:qatr_nominal_frame",
        "span_sha256": "7b9a37dce42019387016ad60719167eac6980f49fc59710e5e7f8efad26dcbd6",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 11933,
        "byte_end": 13243,
        "line_start": 152,
        "line_end": 164,
        "raw_text": "### | باب المبتدأ والخبر مرفوعان:\n# ك \"الله ربنا\"، و \"محمد نبينا\"، ويقع المبتدأ نكرة إن عم أو خص، نحو \"ما\n~~رجل في الدار\" و {إله مع الله} ، {ولعبد مؤمن خير من مشرك} وخمس صلوات\n~~كتبهن الله.\n# PageV01P009\n# والخبر جملة لها رابط ك \"زيد أبوه قائم\" و {ولباس التقوى ذلك خير} و\n~~{الحاقة ما الحاقة} و \"زيد نعم الرجل\"، إلا في نحو: {قل هو الله أحد} ،\n~~وظرفا منصوبا، نحو {والركب أسفل منكم} ، وجارا ومجرورا ك {الحمد لله رب\n~~العالمين} ، وتعلقهما ب\"مستقر\" أو \"استقر\" محذوفتين ولا يخبر بالزمان عن\n~~الذات، والليلة والهلال متأول. ويغني عن الخبر مرفوع وصف معتمد على\n~~استفهام، أو نفي، نحو \"أقاطن قوم سلمى\" و \"ما مضروب العمران\" وقد يتعدد\n~~الخبر، نحو \"وهو الغفور الودود\". وقد يتقدم، نحو \"في الدار زيد\" و \"أين\n~~زيد\" وقد يحذف كل من المبتدإ والخبر نحو {سلام قوم منكرون} أي عليكم أنتم.\n"
      },
      {
        "target": "acquisition-passage:ibn_aqil_fronting",
        "span_sha256": "42f0cb90318dcc69419e44d7aecc5705ded939388dee224a30f53270b1ca2ffb",
        "kind": "passage_quotation",
        "source_id": "ibn_aqil",
        "source_revision": "661e43ea265eca8c72b9e4ab7a46cd9182b34e834105b595241bc7787b471f09",
        "byte_start": 161746,
        "byte_end": 163051,
        "line_start": 1623,
        "line_end": 1634,
        "raw_text": "# والأصل في الأخبار أن تؤخرا ... وجوزوا التقديم إذ لا ضررا (1)\n# الأصل تقديم المبتدأ وتأخير الخبر وذلك لأن الخبر وصف في المعنى للمبتدأ\n~~فاستحق التأخير كالوصف ويجوز تقديمه إذا لم يحصل بذلك لبس أو نحوه على ما\n~~سيبين فتقول قائم زيد وقائم أبوه زيد وأبوه منطلق زيد وفى الدار زيد وعندك\n~~عمرو وقد وقع في كلام بعضهم أن\n# مذهب PageV01P227\n# الكوفيين منع تقدم الخبر الجائز التأخير عند البصريين وفيه نظر (1) فإن\n~~بعضهم نقل الإجماع من البصريين والكوفيين على جواز في داره زيد فنقل المنع\n~~عن الكوفيين مطلقا ليس بصحيح هكذا قال بعضهم وفيه بحث (1) نعم منع الكوفيون\n~~التقديم في مثل زيد قائم وزيد قام أبوه PageV01P228\n# وزيد أبوه منطلق والحق الجواز إذ لا مانع من ذلك وإليه أشار بقوله وجوزوا\n~~التقديم إذ لا ضررا فتقول قائم زيد ومنه قولهم مشنوء من يشنؤك فمن مبتدأ\n"
      },
      {
        "target": "acquisition-passage:ibn_aqil_fronting_restrictions",
        "span_sha256": "60920d1da455ad19c3c05d4f68fe23e8e41cc3601fe94ba9a05552781d32a5db",
        "kind": "passage_quotation",
        "source_id": "ibn_aqil",
        "source_revision": "661e43ea265eca8c72b9e4ab7a46cd9182b34e834105b595241bc7787b471f09",
        "byte_start": 163890,
        "byte_end": 166385,
        "line_start": 1646,
        "line_end": 1668,
        "raw_text": "# فامنعه حين يستوي الجزآن ... عرفا ونكرا عادمي بيان (1)\n# كذا إذا ما الفعل كان الخبرا ... أو قصد استعماله منحصرا (2) PageV01P231\n# أو كان مسندا لذي لام ابتدا ... أو لازم الصدر كمن لي منجدا (1)\n# ينقسم الخبر بالنظر إلى تقديمه على المبتدأ أو تأخيره عنه ثلاثة أقسام\n~~قسم يجوز فيه التقديم والتأخير وقد سبق ذكره وقسم يجب فيه تأخير الخبر وقسم\n~~يجب فيه تقديم الخبر.\n# فأشار بهذه الأبيات إلى الخبر الواجب التأخير فذكر منه خمسة مواضع:\n# الأول: أن يكون كل من المبتدأ والخبر معرفة أو نكرة صالحة لجعلها مبتدأ\n~~ولا مبين للمبتدأ من الخبر نحو زيد أخوك وأفضل من زيد أفضل من عمرو ولا\n~~يجوز تقديم الخبر في هذا ونحوه لأنك لو قدمته فقلت أخوك زيد وأفضل من عمرو\n~~أفضل من زيد لكان المقدم مبتدأ (2)\n# (2) وأنت PageV01P232\n# تريد أن يكون خبرا من غير دليل يدل عليه فإن وجد دليل يدل على أن المتقدم\n~~خبر جاز كقولك أبو يوسف أبو حنيفة فيجوز تقدم الخبر وهو أبو حنيفة لأنه\n~~معلوم أن المراد تشبيه أبي يوسف بأبي حنيفة ولا تشبيه أبي حنيفة بأبي يوسف\n~~ومنه قوله:\n# بنونا بنو أبنائنا وبناتنا ... بنوهن أبناء الرجال الأباعد PageV01P233\n# فقوله بنونا خبر مقدم وبنو أبنائنا مبتدأ مؤخر لأن المراد الحكم على بني\n~~أبنائهم بأنهم كبنيهم وليس المراد الحكم على بنيهم بأنهم كبني أبنائهم.\n# والثاني: أن يكون الخبر فعلا رافعا لضمير المبتدأ مستترا نحو زيد قام\n~~فقام وفاعله المقدر (1) خبر عن زيد ms055 ولا يجوز التقديم فلا يقال قام زيد على\n~~أن يكون زيد مبتدأ مؤخرا والفعل خبرا مقدما بل يكون زيد فاعلا لقام فلا\n~~يكون من باب المبتدأ والخبر بل من باب الفعل والفاعل فلو كان الفعل رافعا\n"
      },
      {
        "target": "acquisition-passage:ibn_aqil_descriptor_dispute",
        "span_sha256": "7a3b83bfc5a185ecc55d8501ccf37e5785003370f32cd83f53710c366bdf447d",
        "kind": "passage_quotation",
        "source_id": "ibn_aqil",
        "source_revision": "661e43ea265eca8c72b9e4ab7a46cd9182b34e834105b595241bc7787b471f09",
        "byte_start": 136877,
        "byte_end": 144091,
        "line_start": 1371,
        "line_end": 1443,
        "raw_text": "~~نداء ولا في غيره نحو يا ابن عمر. PageV01P187\n### | الابتداء\n# مبتدأ زيد وعاذر خبر ... إن قلت زيد عاذر من اعتذر (1)\n# وأول مبتدأ والثاني فاعل ... اغنى في أسار ذان (2)\n# وقس وكاستفهام النفي وقد ... يجوز نحو فائز أولوا الرشد (3) PageV01P188\n# ذكر المصنف أن المبتدأ على قسمين مبتدأ له خبر ومبتدأ له فاعل سد مسد\n~~الخبر فمثال الأول زيد عاذر من اعتذر والمراد به ما لم يكن المبتدأ فيه\n~~وصفا مشتملا على ما يذكر في القسم الثاني فزيد مبتدأ وعاذر خبره ومن اعتذر\n~~مفعول لعاذر ومثال الثاني أسار ذان فالهمزة للاستفهام وسار مبتدأ وذان فاعل\n~~سد مسد الخبر ويقاس على هذا ما كان مثله وهو كل وصف اعتمد على استفهام أو\n~~نفي نحو أقائم الزيدان وما قائم الزيدان فإن لم يعتمد الوصف لم يكن مبتدأ\n~~وهذا مذهب البصريين إلا الأخفش ورفع (1) فاعلا ظاهرا كما مثل أو ضميرا\n~~منفصلا نحو أقائم أنتما وتم الكلام به (1) فإن لم يتم به الكلام لم يكن\n~~مبتدأ نحو أقائم أبواه زيد فزيد مبتدأ مؤخر وقائم خبر مقدم وأبواه فاعل\n~~بقائم ولا يجوز أن يكون قائم مبتدأ لأنه لا يستغني بفاعله حينئذ إذ لا يقال\n~~أقائم أبواه فيتم الكلام وكذلك لا يجوز أن يكون الوصف مبتدأ إذا رفع ضميرا\n~~مستترا فلا يقال في ما زيد قائم ولا قاعد إن قاعدا مبتدأ والضمير المستتر\n~~فيه فاعل أغنى عن الخبر لأنه ليس بمنفصل على أن في المسألة خلافا (2) ولا\n~~فرق بين أن يكون الاستفهام\n# بالحرف كما مثل PageV01P189\n# أو بالاسم كقولك كيف جالس العمران (1) وكذلك لا فرق بين أن يكون النفي\n~~بالحرف كما مثل أو بالفعل كقولك ليس قائم الزيدان فليس فعل ماض ناقص وقائم\n~~اسمه والزيدان فاعل سد مسد خبر ليس وتقول غير قائم الزيدان فغير مبتدأ\n~~وقائم مخفوض بالإضافة والزيدان فاعل بقائم سد مسد خبر غير لأن المعنى ما\n~~قائم الزيدان فعومل غير قائم معاملة ما قائم ومنه قوله:\n### | 38 - \n# غير لاه عداك فاطرح ms046 ... اللهو ولا تغترر بعارض سلم PageV01P190\n# فغير مبتدأ ولاه مخفوض بالإضافة وعداك فاعل بلاه سد مسد خبر غير ومثله\n~~قوله:\n### | 39 - \n# غير مأسوف على زمن ... ينقضي بالهم والحزن PageV01P191\n# فغير مبتدأ ومأسوف مخفوض بالإضافة وعلى زمن جار ومجرور في موضع رفع\n~~بمأسوف لنيابته مناب الفاعل وقد سد مسد خبر غير.\n# وقد سأل أبو الفتح بن جني ولده عن إعراب هذا البيت فارتبك في إعرابه\n~~ومذهب البصريين إلا الأخفش أن هذا الوصف لا يكون مبتدأ إلا إذا اعتمد على\n~~نفي أو استفهام (1) وذهب الأخفش والكوفيون إلى عدم اشتراط PageV01P192\n# ذلك فأجازوا قائم الزيدان فقائم مبتدأ والزيدان فاعل سد مسد الخبر.\n~~PageV01P193\n# وإلى هذا أشار المصنف بقوله وقد يجوز نحو فائز أولو الرشد أي وقد يجوز\n~~استعمال هذا الوصف مبتدأ من غير أن يسبقه نفي أو استفهام وزعم المصنف أن\n~~سيبويه يجيز ذلك على ضعف ومما ورد منه قوله:\n### | 40 - \n# فخير نحن عند الناس منكم ... إذا الداعي المثوب قال: يالا PageV01P194\n# فخير: مبتدأ ونحن فاعل سد مسد الخبر ولم يسبق خير نفي ولا استفهام وجعل\n~~من هذا قوله:\n### | 41 - \n# خبير بنو لهب فلا تك ملغيا ... مقالة لهبي إذا الطير مرت\n# فخبير: مبتدأ وبنو لهب: فاعل سد مسد الخبر. PageV01P195\n# والثان مبتدأ وذا الوصف خبر ... إن في سوى الإفراد طبقا استقر (1)\n~~PageV01P196\n# الوصف مع الفاعل إما أن يتطابقا إفرادا أو تثنية أو جمعا أو لا يتطابقا\n~~وهو قسمان ممنوع وجائز.\n# فإن تطابقا إفرادا نحو أقائم زيد جاز فيه وجهان (1) :\n# أحدهما: أن PageV01P197\n# يكون الوصف مبتدأ وما بعده فاعل سد مسد الخبر.\n# والثاني: أن يكون ما بعده مبتدأ مؤخرا ويكون الوصف خبرا مقدما ومنه قوله\n~~تعالى (1) : {أراغب أنت عن آلهتي يا إبراهيم} فيجوز أن يكون أراغب مبتدأ\n~~وأنت فاعل سد مسد الخبر ويحتمل أن يكون أنت مبتدأ مؤخرا وأراغب خبرا مقدما.\n# والأول في هذه الآية أولى لأن قوله عن آلهتي معمول لراغب فلا يلزم في\n~~الوجه الأول الفصل بين العامل والمعمول بأجنبي لأن أنت على هذا التقدير\n~~فاعل لراغب فليس بأجنبي منه ms047 وأما على الوجه الثاني فيلزم فيه الفصل بين\n~~العامل والمعمول بأجنبي لأن أنت أجنبي من راغب على هذا التقدير لأنه مبتدأ\n~~فليس لراغب عمل فيه لأنه خبر والخبر لا يعمل في المبتدأ على الصحيح.\n# وإن تطابقا تثنية نحو أقائمان الزيدان أو جمعا نحو أقائمون الزيدون فما\n~~بعد الوصف مبتدأ والوصف خبر مقدم وهذا معنى قول المصنف والثان مبتدأ وذا\n~~الوصف خبر إلى آخر البيت أي والثاني وهو ما بعد الوصف - مبتدأ والوصف خبر\n~~عنه مقدم عليه إن تطابقا في غير الإفراد - PageV01P198\n# وهو التثنية والجمع - هذا على المشهور من لغة العرب\n# ويجوز على لغة أكلوني البراغيث أن يكون الوصف مبتدأ وما بعده فاعل أغنى\n~~عن الخبر.\n# وإن لم يتطابقا وهو قسمان ممتنع وجائز كما تقدم فمثال الممتنع أقائمان\n~~زيد وأقائمون زيد فهذا التركيب غير صحيح ومثال الجائز أقائم الزيدان وأقائم\n~~الزيدون وحينئذ يتعين أن يكون الوصف مبتدأ وما بعده فاعل سد مسد الخبر. (1)\n"
      },
      {
        "target": "acquisition-passage:ibn_aqil_predicate_agreement",
        "span_sha256": "4b6b0ab7136abdad4fa13de25c08f3f64fae1c7b625741500fa05a9a5e45c184",
        "kind": "passage_quotation",
        "source_id": "ibn_aqil",
        "source_revision": "661e43ea265eca8c72b9e4ab7a46cd9182b34e834105b595241bc7787b471f09",
        "byte_start": 732222,
        "byte_end": 733113,
        "line_start": 7838,
        "line_end": 7844,
        "raw_text": "# أي إذا كان الاسم الذي قيل لك أخبر عنه مثنى فجيء بالموصول مثنى كاللذين\n~~وإن كان مجموعا فجيء به كذلك كالذين وإن كان مؤنثا فجيء به كذلك كالتي.\n# والحاصل أنه لا بد من مطابقة الموصول للاسم المخبر عنه به لأنه خبر عنه\n~~ولا بد من مطابقة الخبر للمخبر عنه إن مفردا فمفرد وإن مثنى فمثنى وإن\n~~مجموعا فمجموع وإن مذكرا فمذكر وإن مؤنثا فمؤنث. فإذا قيل لك أخبر عن\n~~الزيدين من ضربت الزيدين قلت اللذان ضربتهما الزيدان وإذا قيل أخبر عن\n~~الزيدين من ضربت الزيدين قلت الذين ضربتهم الزيدون وإذا ms249 قيل أخبر عن هند من\n"
      },
      {
        "target": "productive-passage:QATR_CASE",
        "span_sha256": "f188bafd55466e5862fc518b43d2b2da7d8c73bdd23cf5c0959921a197288bf2",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 3820,
        "byte_end": 4538,
        "line_start": 73,
        "line_end": 81,
        "raw_text": "# والكلام: لفظ مفيد. وأقل ائتلافه من اسمين ك\"زيد قائم\"، أو فعل واسم\n~~ك\"قام زيد\".\n# فصل: أنواع الإعراب أربعة.\n# (1) رفع (2) ونصب في اسم وفعل نحو \"زيد يقوم\" و \"إن زيدا لن يقوم\"، (3)\n~~وجر في اسم نحو \"بزيد\"، (4) وجزم نحو \"لم يقم\". فيرفع بضمة، وينصب بفتحة،\n~~ويجر بكسرة، ويجزم بحذف حركة، إلا الأسماء الستة، وهي أبوه وأخوه وحموها\n~~وهنوه وفوه وذو مال، فترفع بالواو وتنصب بالألف وتجر بالياء. والأفصح\n~~استعمال هن كغد.\n# PageV01P005\n"
      },
      {
        "target": "productive-passage:QATR_PROPER_NAMES",
        "span_sha256": "70e7f233135f9376c3da1a7a2b861411063e60d89007b0219b21126ae6da0135",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 9558,
        "byte_end": 9925,
        "line_start": 129,
        "line_end": 131,
        "raw_text": "# ثم العلم وهو: إما شخصي ك \"زيد\" أو جنسي ك \"أسامة\"، وإما اسم كما مثلنا\n~~أو لقب ك\"زين العابدين\" و \"قفة\" أو كنية ك\"أبي عمرو\" و \"أم كلثوم\". ويؤخر\n~~اللقب عن الاسم تابعا له مطلقا، أو مخفوضا بإضافته إن أفرد ك\"سعيد كرز\".\n"
      },
      {
        "target": "productive-passage:QATR_AGENT",
        "span_sha256": "b4191a3ac55beaef67350b80c2b7d99af4a3cba2d2f6d395461b66a15f8d9b78",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 18540,
        "byte_end": 20379,
        "line_start": 219,
        "line_end": 235,
        "raw_text": "### | باب الفاعل مرفوع:\n# ك\"قام زيد\" و \"مات عمرو\". ولا يتأخر عامله عنه ولا تلحقه علامة تثنية ولا\n~~جمع، بل يقال \"قام رجلان، ورجال، ونساء\" كما يقال \"قام رجل\". وشذ \"يتعاقبون\n~~فيكم ملائكة بالليل\" \"أو مخرجي هم\" وتلحقه علامة تأنيث إن كان مؤثا ك \"قامت\n~~هند\" و \"طلعت الشمس\". ويجوز الوجهان في مجازي التأنيث الظاهر نحو {قد\n~~جاءتكم موعظة من ربكم} ، وفي الحقيقي المنفصل نحو \"حضرت القاضي امرأة\"\n~~والمتصل في باب نعم وبئس نحو \"نعمت المرأة هند\"، وفي الجمع نحو {قالت\n~~الأعراب} إلا جمعي ms06 التصحيح فكمفرديهما نحو \"قام الزيدون\" و \"قامت الهندات\"،\n~~وإنما امتنع في النثر \"ما قامت إلا هند\" لأن الفاعل مذكر محذوف، كحذفه في\n~~نحو {أو إطعام في يوم ذي مسغبة يتيما} و {قضي الأمر} و {أسمع بهم وأبصر} ،\n~~ويمتنع في غيرهن والأصل أن يلي عامله. وقد يتأخر جوازا نحو {ولقد جاء آل\n~~فرعون النذر}\n# PageV01P013\n# وكما أتى ربه موسى على قدر، ووجوبا نحو {وإذ ابتلى إبراهيم ربه} و \"ضربني\n~~زيد\"، وقد يجب تأخير المفعول ك \"ضربت زيدا\" و \"ما أحسن زيدا\" و \"ضرب موسى\n~~عيسى\"، بخلاف \"أرضعت الصغرى الكبرى\"، وقد يتقدم على العامل جوازا نحو\n~~{فريقا هدى} ، ووجوبا نحو \"أيا ما تدعو\" وإذا كان الفعل نعم أو بئس فالفاعل\n"
      },
      {
        "target": "productive-passage:QATR_PATIENT",
        "span_sha256": "f0b4371743c54028ab59e3619f25e03052c63be70593d9eaef5e2816f344baea",
        "kind": "passage_quotation",
        "source_id": "qatr",
        "source_revision": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
        "byte_start": 22745,
        "byte_end": 23042,
        "line_start": 266,
        "line_end": 270,
        "raw_text": "# PageV01P015\n### | باب المفعول منصوب وهو خمسة:\n# المفعول به، وهو ما وقع عليه فعل الفاعل ك \"ضربت زيدا\" ومنه المنادى،\n~~وإنما ينصب مضافا ك \"يا عبد الله\"، أو شبيها بالمضاف\n# PageV01P015\n"
      },
      {
        "target": "productive-passage:SIB_TRANSITIVE",
        "span_sha256": "ba8d7ab247a10e4b8068ccd425fb692351f6f23946ef8c433bad14d0c34b6426",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 36657,
        "byte_end": 37506,
        "line_start": 332,
        "line_end": 338,
        "raw_text": "# | هذا باب الفاعل الذي يتعداه فعله إلى مفعول\n# | وذلك قولك ضرب عبد الله زيدا فعبد الله ارتفع ههنا كما ارتفع في ذهب\n~~وشغلت ضرب به كما شغلت به ذهب وانتصب زيد لأنه مفعول تعدى إليه فعل الفاعل\n~~فإن قدمت المفعول وأخرت الفاعل جرى اللفظ كما جرى في الأول وذلك قولك ضرب\n~~زيدا عبد الله لأنك إنما أردت به مؤخرا ما أردت به مقدما ولم ترد أن تشغل\n~~الفعل بأول منه وإن كان مؤخرا في اللفظ فمن ثم كان حد اللفظ أن يكون فيه\n~~مقدما وهو عربي جيد كثير كأنهم إنما يقدمون الذي بيانه أهم لهم وهم ببيانه\n"
      },
      {
        "target": "productive-passage:SIB_ZAYD_AMR_ORDER",
        "span_sha256": "73ecd34101a6e271ea33f3e2da5edc4e247fedf8455aca52b3552e68b57a9ffe",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 94584,
        "byte_end": 95635,
        "line_start": 834,
        "line_end": 842,
        "raw_text": "# | ( هذا باب ما يكون فيه الاسم مبنيا على الفعل قدم أو أخر وما يكون فيه\n~~الفعل مبنيا على الاسم )\n# | فإذا بنيت الاسم عليه قلت ضربت زيدا وهو الحد لأنك تريد أن تعمله وتحمل\n~~عليه الاسم كما كان الحد ضرب زيد عمرا حيث كان زيد أول ما تشغل به الفعل |\n~~وكذلك هذا إذا كان يعمل فيه | وإن قدمت الاسم فهو عربى جيد كما كان ذلك\n~~عربيا جيدا وذلك قولك زيدا ضربت والاهتمام PageV01P080 والعناية هنا فى\n~~التقديم والتأخير سواء مثله فى ضرب زيد عمرا وضرب عمرا زيد | فإذا بنيت\n~~الفعل على الاسم قلت زيد ضربته فلزمته الهاء | وإنما تريد بقولك مبن ى عليه\n~~الفعل أنه فى موضع منطلق إذا قلت عبد الله منطلق فهو فى موضع هذا الذى بنى\n"
      },
      {
        "target": "productive-passage:SIB_NAME_EXAMPLES",
        "span_sha256": "1124a49eb07a24e2fab81987cba5f17dbff3f91225a36b5e3f6b82c56d95cbc0",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 104836,
        "byte_end": 105611,
        "line_start": 920,
        "line_end": 926,
        "raw_text": "# | ( هذا باب ما يختار فيه إعمال الفعل مما يكون فى المبتدإ مبنيا عليه\n~~الفعل )\n# | وذلك قولك رأيت زيدا وعمرا كلمته ورأيت عبد ms037 الله وزيدا مررت به ولقيت\n~~قيسا وبكرا أخذت أباه ولقيت خالدا وزيدا اشتريت له ثوبا | وإنما اختير\n~~النصب ههنا لأن الاسم الأول مبنى على الفعل فكان بناء الآخر على الفعل أحسن\n~~عندهم إذ كان يبنى على الفعل وليس قبله اسم مبنى على الفعل ليجرى الآخر على\n~~ما جرى عليه الذى يليه قبله إذ كان PageV01P088 لا ينقص المعنى لو بنيته\n"
      },
      {
        "target": "productive-passage:SIB_PROPER_NAMES",
        "span_sha256": "26843a953ebba965bd4d87947abf675fbead9993b0ed2daa470b131e7528d302",
        "kind": "passage_quotation",
        "source_id": "sibawayhi",
        "source_revision": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
        "byte_start": 1367735,
        "byte_end": 1368414,
        "line_start": 11594,
        "line_end": 11599,
        "raw_text": "# | ( هذا باب الألقاب )\n# إذا لقبت مفردا بمفرد أضفته إلى الألقاب وهو قول أبي عمرو ms490 ويونس والخليل\n~~وذلك قولك هذا سعيد كرز وهذا قيس قفة قد جاء وهذا زيد بطة فإنما جعلت قفة\n~~معرفة لأنك أردت المعرفة التي أردتها إذا قلت PageV03P294 هذا قيس فلو نونت\n~~قفة صار الاسم نكرة لأن المضاف إنما يكون نكرة ومعرفة بالمضاف إليه فيصير\n~~قفة هاهنا كأنها كانت معرفة قبل ذلك ثم أضفت إليها | ونظير ذلك أنه ليس\n"
      }
    ],
    "authority": "FULL_FILE_REPLAY_AND_AUTHORED_PROJECTION"
  },
