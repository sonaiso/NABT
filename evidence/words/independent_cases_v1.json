  "sources": [
    {
      "id": "qatr",
      "git_commit": "7360985b14765bfdd1e04dcbd0da57684b50d762",
      "git_path": "src/nabt/data/source_evidence/qatr.txt",
      "sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
      "passages": [
        {
          "id": "word_and_noun",
          "line_start": 41,
          "line_end": 44,
          "byte_start": 1414,
          "byte_end": 1648,
          "sha256": "af3887f99dfbdedb9cd03aaf80dcc0d57cefb37619e20863aad645f3de827947",
          "text": "### | الكلمة وأقسامها\n# الكلمة: قول مفرد. وهي اسم وفعل وحرف.\n# فأما الاسم فيعرف بأل ك\"الرجل\" وبالتنوين ك\"رجل\" وبالحديث عنه كتاء\n~~\"ضربت\".\n"
        },
        {
          "id": "declension_building",
          "line_start": 45,
          "line_end": 52,
          "byte_start": 1648,
          "byte_end": 2194,
          "sha256": "7e49378580600d8d8c0fdac8c7eb72d10e49ba12754b0a3f5b9d7984278e5876",
          "text": "# وهو ضربان:\n### | 1- \n# معرب وهو ما يتغير أواخره بسبب العوامل الداخلة عليه ك\"زيد\".\n### | 2- \n# ومبني وهو بخلافه، ك\"هؤلاء\" في لزوم الكسر، وكذلك حذام وأمس في لغة\n~~الحجازيين، وك\"أحد عشر\" وأخواته في لزوم الفتح، وكقبل وبعد وأخواتهما في\n~~لزوم الضم إذا حذف المضاف إليه ونوي معناه، وكمن وكم في لزوم السكون وهو\n~~أصل البناء.\n"
        },
        {
          "id": "past_and_attached_subject",
          "line_start": 53,
          "line_end": 57,
          "byte_start": 2194,
          "byte_end": 2548,
          "sha256": "05a7b5f59a9d68365303ef257bc66c8830d28aafb5a6bc6b0ea73fd5a6659e1d",
          "text": "# وأما الفعل فثلاثة أقسام:\n### | 1- \n# ماض: ويعرف بتاء التأنيث الساكنة. وبناؤه على الفتح كضرب، إلا مع واو\n~~الجماعة فيضم ك\"ضربوا\"، والضمير المرفوع المتحرك فيسكن ك\"ضربت\". ومنه نعم\n~~وبئس وعسى وليس في الأصح.\n"
        },
        {
          "id": "imperfect",
          "line_start": 64,
          "line_end": 69,
          "byte_start": 2945,
          "byte_end": 3546,
          "sha256": "f50b02b64fd8cd350cecbafdc2f1312c079336ccfb24aa3d407ef758af9ef4a7",
          "text": "### | 3- \n# ومضارع: ويعرف بلم. وافتتاحه بحرف من نأيت، نحو نقوم وأقوم ويقوم وتقوم.\n~~ويضم أوله إن كان ماضيه رباعيا ك\"يدحرج ويكرم\"، ويفتح في غيره ك\"يضرب\n~~ويستخرج\". ويسكن آخره مع نون النسوة نحو يتربصن وإلا أن يعفون، ويفتح مع\n~~نون التوكيد المباشرة لفظا وتقديرا نحو لينبذن، ويعرب فيما عدا ذلك نحو\n~~يقوم زيد ولا تتبعان لتبلون فإما ترين ولا يصدنك.\n"
        },
        {
          "id": "particle",
          "line_start": 70,
          "line_end": 72,
          "byte_start": 3546,
          "byte_end": 3820,
          "sha256": "7511a2a1ece6bf92aac081a57594b640ff8300ef119bdd22513d733de61b2f92",
          "text": "# وأما الحرف: فيعرف بأن لا يقبل شيئا من علامات الاسم والفعل، نحو هل وبل.\n~~وليس منه مهما وإذما، بل ما المصدرية ولما الرابطة في الأصح. وجميع الحروف\n~~مبنية.\n"
        },
        {
          "id": "minimal_clause",
          "line_start": 73,
          "line_end": 74,
          "byte_start": 3820,
          "byte_end": 3959,
          "sha256": "2f38c85482b42eaac7fa1fb7f3d4f178018b503a9bc29e22195c3525c469500d",
          "text": "# والكلام: لفظ مفيد. وأقل ائتلافه من اسمين ك\"زيد قائم\"، أو فعل واسم\n~~ك\"قام زيد\".\n"
        },
        {
          "id": "case_and_jussive_example",
          "line_start": 75,
          "line_end": 79,
          "byte_start": 3959,
          "byte_end": 4494,
          "sha256": "9f7941ee9cd9f55840fdd3f40715b9c42596bfa991a406e51625f9fd00801359",
          "text": "# فصل: أنواع الإعراب أربعة.\n# (1) رفع (2) ونصب في اسم وفعل نحو \"زيد يقوم\" و \"إن زيدا لن يقوم\"، (3)\n~~وجر في اسم نحو \"بزيد\"، (4) وجزم نحو \"لم يقم\". فيرفع بضمة، وينصب بفتحة،\n~~ويجر بكسرة، ويجزم بحذف حركة، إلا الأسماء الستة، وهي أبوه وأخوه وحموها\n~~وهنوه وفوه وذو مال، فترفع بالواو وتنصب بالألف وتجر بالياء. والأفصح\n"
        },
        {
          "id": "noun_reference_and_pronoun",
          "line_start": 122,
          "line_end": 130,
          "byte_start": 8870,
          "byte_end": 9799,
          "sha256": "65837db4af47469ef763260c13ec30a23a575ab00dd623153659d5f9ad8d7774",
          "text": "# فصل: الاسم ضربان.\n# نكرة، وهو ما شاع في جنس موجود ك\"رجل\" أو مقدر ك\"شمس\"، ومعرفة وهي ستة:\n~~الضمير وهو ما دل على متكلم أو مخاطب أو غائب. وهو إما مستتر كالمقدر وجوبا\n~~في نحو \"أقوم\" و \"تقوم\" أو جوازا فشي نحو \"زيد يقوم\"، أو بارز وهو إما متصل\n~~ك\"تاء\" \"قمت\" وكاف \"أكرمك\" وهاء \"غلامه\"، أو منفصل ك\"أنا وأنت وإياي\". ولا\n~~فصل مع إمكان الوصل، إلا في نحو الهاء من \"سلنيه\" بمرجوحية، و \"ظننتكه\" و\n~~\"كنته\" برجحان.\n# ثم العلم وهو: إما شخصي ك \"زيد\" أو جنسي ك \"أسامة\"، وإما اسم كما مثلنا\n~~أو لقب ك\"زين العابدين\" و \"قفة\" أو كنية ك\"أبي عمرو\" و \"أم كلثوم\". ويؤخر\n"
        },
        {
          "id": "explicit_huwa",
          "line_start": 157,
          "line_end": 158,
          "byte_start": 12267,
          "byte_end": 12501,
          "sha256": "261c7f1ba9da0b163691bd33c90747a16af98d93d1259519a15cee963028e749",
          "text": "# والخبر جملة لها رابط ك \"زيد أبوه قائم\" و {ولباس التقوى ذلك خير} و\n~~{الحاقة ما الحاقة} و \"زيد نعم الرجل\"، إلا في نحو: {قل هو الله أحد} ،\n"
        },
        {
          "id": "inna_roles_blocker",
          "line_start": 187,
          "line_end": 190,
          "byte_start": 15482,
          "byte_end": 15986,
          "sha256": "a72b28bffeed9a4fa9e9df1ea20e36b795442213dca9ca236a2c79993e8a8cba",
          "text": "# الثاني: إن وأن للتأكيد، ولكن للاستدراك، وكأن للتشبيه أو الظن، وليت\n~~للتمني، ولعل للترجي أو الإشفاق أو التعليل. فينصبن المبتدأ اسما لهن،\n~~ويرفعن الخبر خبرا لهن، إن لم تقترن بهن ما الحرفية: نحو {إنما الله إله\n~~واحد} إلا ليت فيجوز الأمران، كإن المكسورة مخففة فأما لكن مخففة فتهمل.\n"
        },
        {
          "id": "preposition",
          "line_start": 337,
          "line_end": 340,
          "byte_start": 29228,
          "byte_end": 29659,
          "sha256": "eef29830facf3049cbccfffffec98c0f3269b02c3b8f9b7866746a743aaa0407",
          "text": "### | باب يخفض الاسم إما بحرف مشترك:\n# وهو من وإلى وعن وعلى وفي واللام والباء للقسم وغيره - أو مختص بالظاهر -\n~~وهو رب ومذ ومنذ والكاف وحتى وواو القسم وتاؤه - أو بإضافة إلى اسم على\n~~معنى اللام ك \"غلام زيد\" أو من ك\"خاتم حديد\" أو في ك \"مكر الليل\" وتسمى\n"
        }
      ]
    }
  ],
