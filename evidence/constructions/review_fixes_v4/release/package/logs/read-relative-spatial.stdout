                "span_sha256": "7584bb6de64b57a5ddc7515bc290d140c3d876799276156b0bd73973673e29a3",
                "line_start": 4780,
                "line_end": 4800,
                "premise_scope": "A simple source-declared direct adjectival predicative reading with a preserved independently licensed predication edge and reference. Compare gender and number only when its canonical direct agreement regime is independently licensed; do not infer that regime from spelling, generic ADJ, known gender, or derivational origin alone. The current acquisition scope may be restricted to an explicitly human singular owner and an explicit adjective reading. A nominal predicate, instrument/time/place noun, overt raised-dependent/causal adjective, nonhuman plural, invariant/exceptional description or unknown regime is not silently admitted. Subject/predicate case and definiteness need not match; no naat case/definiteness law is transferred. Kana/inna compare their subject with the adjective predicate; a qualified zanna frame compares object1 with object2, not the experiencer. Unknown feature or unlicensed regime is unresolved, not agreement or a universal grammatical refutation. Preserve operator scope, existing readings and reference; no gender, number, referent, attachment or world truth is acquired by this conditional law."
              }
            },
            {
              "kind": "source_construction_grammar",
              "rule": "temporal_spatial_attachment",
              "law_id": "nabt.construction-evidence.v2",
              "law_sha256": "7cda6fd3736cbd5935bc9a9c3ab0e6510abbacc2f234bd752ab6846ba32e9595",
              "policy_sha256": "d1c3a775f30d503bd1d43f7e570808c6b1c1ca554ca36b2a94302a3fbc8146ed",
              "passage": {
                "source_id": "qatr",
                "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
