      "source_policy_id": "nabt.construction-grammar-sources.v1"
    },
    "grammar_sources": {
      "policy_id": "nabt.construction-grammar-sources.v1",
      "policy_sha256": "51cd562baefd50a3de493fb88cb39f5b9442c648acdeedd02cdd3a75de378bb4",
      "rules": {
        "kana_sisters": {
          "source_id": "alfiyya",
          "source_commit": "4b1d2886508b435eb0377ccab96e1da96cc8ee0a",
          "source_path": "data/0672IbnMalik/0672IbnMalik.Alfiyya/0672IbnMalik.Alfiyya.Shamela0008522-ara1",
          "source_sha256": "13b351a0a02d9060fdedbb5db568544718eb4e89bef323f5572b8a26c0921ca0",
          "start": 14745,
          "end": 16168,
          "span_sha256": "5ee7d61b5a70063d29913995b15bba3dbc04a4fe10d5e4ee855d1ef6d6b60898",
          "line_start": 209,
          "line_end": 224,
          "premise_scope": "Qualified incomplete kana-family reading with a nominative name and accusative predicate. The four continuation verbs require negation or its licensed equivalent; dam requires the stated ma. Complete, additional, deleted and lexical readings are separate alternatives. Tense and the meaning of each sister remain explicit."
        },
        "inna_sisters": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 15482,
          "end": 17068,
          "span_sha256": "2ab693253c3f5dedb8e570183304e50bb63caab1c79a997e20418d81a979f36a",
          "line_start": 187,
          "line_end": 200,
          "premise_scope": "Qualified operative inna-family reading with accusative name and nominative predicate. Emphasis, correction, comparison/supposition, wish and hope/fear/reason are distinct. Ma-kaffa, reduced forms, clause embedding and scope can block the ordinary frame. Case does not authorize assertion or factual projection."
        },
        "zanna_sisters": {
          "source_id": "sibawayhi",
          "source_commit": "599f22fe249871f602efe2e0ddc801d3742960a3",
          "source_path": "data/0180Sibawayhi/0180Sibawayhi.KitabSibawayhi/0180Sibawayhi.KitabSibawayhi.JK006989-ara1",
          "source_sha256": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
          "start": 44437,
          "end": 46949,
          "span_sha256": "e183fa7684ea8c02a1c373bda5633c8aeed0aca7e2b90988334a434d225880a5",
          "line_start": 398,
          "line_end": 418,
          "premise_scope": "Qualified cognitive reading with an experiencer and a two-part embedded predication. Certainty or doubt is attributed to that experiencer. Seeing, finding, knowing-as-recognition and accusation are distinct readings. No general rule projects the embedded proposition as a fact; no universal claim that every lexical member lacks factive uses."
        },
        "kada_complement": {
          "source_id": "alfiyya",
          "source_commit": "4b1d2886508b435eb0377ccab96e1da96cc8ee0a",
          "source_path": "data/0672IbnMalik/0672IbnMalik.Alfiyya/0672IbnMalik.Alfiyya.Shamela0008522-ara1",
          "source_sha256": "13b351a0a02d9060fdedbb5db568544718eb4e89bef323f5572b8a26c0921ca0",
          "start": 16848,
          "end": 17812,
          "span_sha256": "372558255f9df84007c6f7ff2f6a8a9640b570e412ae7420f9a5a31a8e422442",
          "line_start": 235,
          "line_end": 246,
          "premise_scope": "Qualified approximation, hope or inception reading. The ordinary predicate is imperfect; an is required with hara/ikhlaulaqa, absent with inception, frequent with asa/awshaka, and less frequent with kada/kariba. Rarity is not ungrammaticality. Complete asa/ikhlaulaqa/awshaka and exceptional predicates remain separate. Do not infer realized embedded truth from approximation or hope."
        },
        "tense_aspect": {
          "source_id": "sibawayhi",
          "source_commit": "599f22fe249871f602efe2e0ddc801d3742960a3",
          "source_path": "data/0180Sibawayhi/0180Sibawayhi.KitabSibawayhi/0180Sibawayhi.KitabSibawayhi.JK006989-ara1",
          "source_sha256": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
          "start": 9322,
          "end": 10390,
          "span_sha256": "957c3912c2370990a27a16b779dbd620feb6836ac42f771668c050716d673ef7",
          "line_start": 102,
          "line_end": 110,
          "premise_scope": "Morphological verbal patterns can express past, prospective/nonoccurred or ongoing events. Imperfect morphology alone does not choose present versus future. Relative anchors, operators, negation, reported scope and event boundaries are additional premises; the source does not supply a universal modern tense/aspect parser."
        },
        "naat_agreement": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 32936,
          "end": 33822,
          "span_sha256": "ee213f00f0186d145057aa4f8204c0e447987141f02c52c701fe50932117fdea",
          "line_start": 374,
          "line_end": 383,
          "premise_scope": "A witnessed adjective-head relation follows its head in case and definiteness. A true adjective with an implicit subject also follows gender and number; a causal adjective is treated like a verb relative to its overt dependent. Detached praise/blame descriptions need their own licensed interpretation. Matching endings or adjacency do not create the relation."
        },
        "hal_attachment": {
          "source_id": "alfiyya",
          "source_commit": "4b1d2886508b435eb0377ccab96e1da96cc8ee0a",
          "source_path": "data/0672IbnMalik/0672IbnMalik.Alfiyya/0672IbnMalik.Alfiyya.Shamela0008522-ara1",
          "source_sha256": "13b351a0a02d9060fdedbb5db568544718eb4e89bef323f5572b8a26c0921ca0",
          "start": 33214,
          "end": 35368,
          "span_sha256": "628c187a24ce66c4c89ac863c86b79dc10cf0b6095ea525d297216c14fca8c75",
          "line_start": 441,
          "line_end": 467,
          "premise_scope": "A witnessed circumstantial predicate modifies an independently licensed owner and event/scope. Indefiniteness may be semantic rather than orthographic; owners normally have definiteness or a stated exception. Derived/transient descriptions are frequent, not universal requirements. Clausal hal needs its own pronoun/waw link. No unconditional identity or enduring unqualified property follows."
        },
        "tamyiz_measure": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 27130,
          "end": 27772,
          "span_sha256": "23e14a61edb697ba522bb824033ba8af09898e784844fa54da9e188a63f9198c",
          "line_start": 313,
          "line_end": 317,
          "premise_scope": "Indefinite explanatory substantive with independent evidence of a measure, a bounded number construction or a licensed kam reading. Numerical class and case depend on the governing construction: 11..99, 3..10 and 100-plus are not one rule. Interrogative and exclamatory kam differ; preposition-governed interrogative kam permits the stated alternatives. Accusative indefinite nouns alone do not identify tamyiz."
        },
        "tamyiz_nisba": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 27772,
          "end": 28243,
          "span_sha256": "d419f46b6bb84b952d9210c31d148a00bdbec026020b20e16276f87d71679472",
          "line_start": 318,
          "line_end": 325,
          "premise_scope": "An independently witnessed ratio/predication ambiguity is explained by a nisba-tamyiz, transformed or untransformed. Its lexical attachment and valency are separate evidence; neither any noun after a verb nor a failed object analysis supplies that evidence. The source records disagreement over emphatic tamyiz; no universal agreement is asserted."
        },
        "badal_identity": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 35794,
          "end": 36217,
          "span_sha256": "e2d6d713f4d58f1b7e4ab430f12aaa0499b38013a777cfc3d7fb538ba4164640",
          "line_start": 409,
          "line_end": 412,
          "premise_scope": "A witnessed substitution relation carries the judgment without an intervening conjunction. Whole substitution, part, association, correction, slip and forgetfulness are distinct; only separately evidenced same-reference whole substitution can license identity. Case agreement and adjacency never establish identity; speaker intention is not acquired from these lines."
        },
        "tawkeed_reference": {
          "source_id": "alfiyya",
          "source_commit": "4b1d2886508b435eb0377ccab96e1da96cc8ee0a",
          "source_path": "data/0672IbnMalik/0672IbnMalik.Alfiyya/0672IbnMalik.Alfiyya.Shamela0008522-ara1",
          "source_sha256": "13b351a0a02d9060fdedbb5db568544718eb4e89bef323f5572b8a26c0921ca0",
          "start": 51264,
          "end": 52574,
          "span_sha256": "cb8ccc9fc705355843a98c01440124cce08baf39d9c801ef1761b290a22483c1",
          "line_start": 677,
          "line_end": 692,
          "premise_scope": "Semantic emphasis by nafs/ayn and the stated totality forms requires a pronoun matching the emphasized referent, with number restrictions and the separate-pronoun condition for emphatic nafs/ayn after an attached nominative pronoun. Literal repetition requires the repeated licensed expression and scope. The source records disagreement over indefinite emphasis. It is not an unrestricted repeated-token classifier."
        },
        "idafa_chain": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 29228,
          "end": 30201,
          "span_sha256": "2d7784c150aedeabd202b5c09c52055b8122920030aa41e7f9a33aedab3cc5ad",
          "line_start": 337,
          "line_end": 345,
          "premise_scope": "Each independently witnessed idafa edge has a genitive dependent and distinguishes semantic lam/min/fi readings from verbal/lexical idafa. Definite inheritance, article compatibility and removal of tanwin or inflectional nun depend on that reading. A finite chain is new NABT composition of individually licensed edges, not a source claim that every adjacent noun sequence is idafa or ownership."
        },
        "temporal_spatial_attachment": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 25696,
          "end": 26137,
          "span_sha256": "51b187277737261677f64fcc2f923993bf058074b885aca70f283f527b536c6f",
          "line_start": 297,
          "line_end": 300,
          "premise_scope": "A time noun or qualified place expression is governed with fi meaning by a licensed event or equivalent governor. The six directions, analogous relational places, measures and same-source derived places have different qualification premises; a specific place is not automatically an accusative adverb. An adverb label alone does not identify attachment or a real-world temporal/spatial anchor."
        },
        "counted_tens_forms": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 4538,
          "end": 5012,
          "span_sha256": "083768c52e6428c596b3c73620a0e50dc89beb2eb1ec5a069d3b91fbd5ad793a",
          "line_start": 82,
          "line_end": 85,
          "premise_scope": "Conditional declension of a source-qualified numeral reading: twenty and its sisters follow the stated waw nominative / ya accusative-genitive regime. The cited class is supplied or independently acquired; this does not infer a lexical numeral class from an ending, assert sound-plural semantics, enumerate every tens lexeme, or establish real-world cardinality."
        },
        "counted_tens_specification": {
          "source_id": "alfiyya",
          "source_commit": "4b1d2886508b435eb0377ccab96e1da96cc8ee0a",
          "source_path": "data/0672IbnMalik/0672IbnMalik.Alfiyya/0672IbnMalik.Alfiyya.Shamela0008522-ara1",
          "source_sha256": "13b351a0a02d9060fdedbb5db568544718eb4e89bef323f5572b8a26c0921ca0",
          "start": 72061,
          "end": 72222,
          "span_sha256": "b53eceeaade761a450e94448c4e8929be6154207fa56f6c0e731fbf941d9d5b4",
          "line_start": 952,
          "line_end": 953,
          "premise_scope": "Given an independently source-qualified reading in the twenty-to-ninety numeral class and an acquired count-specification attachment, the specified noun is singular. The general tamyiz rule and its own source-backed case/surface premises govern the accusative realization. No unobserved lemma or numerical world fact is supplied by this passage."
        },
        "counted_tens_paradigm": {
          "source_id": "sibawayhi",
          "source_commit": "599f22fe249871f602efe2e0ddc801d3742960a3",
          "source_path": "data/0180Sibawayhi/0180Sibawayhi.KitabSibawayhi/0180Sibawayhi.KitabSibawayhi.JK006989-ara1",
          "source_sha256": "a160f940bb194e6fe7e6655d2c7f28e41f1fc648c4c5e340cc4e42306d5cb625",
          "start": 706628,
          "end": 708420,
          "span_sha256": "cb90b3174718ef43821aa64691c96572de1699ab186c9a0a1d92dd40873a5e1a",
          "line_start": 5986,
          "line_end": 5999,
          "premise_scope": "Named numerical hosts twenty, thirty and forty are discussed with an indefinite singular specification, and their relation to interrogative kam is explained. This is a declared grammatical source paradigm; an occurrence still needs its source-qualified numeral lemma, declension and attachment. The passage does not enumerate a complete spelling-to-integer dictionary or certify a quantity in the world."
        },
        "attested_accusative_alif": {
          "source_id": "qatr",
          "source_commit": "61b0c7891699554aeff8dffdb8b1a2a59d2d22ab",
          "source_path": "data/0761JamalDinIbnHisham/0761JamalDinIbnHisham.MatnQatrNada/0761JamalDinIbnHisham.MatnQatrNada.Shamela0011376-ara1",
          "source_sha256": "2d9241beca1b138187ace8f6782d5eed68f3864f402ec1d5fc90fdeb306ceb9d",
          "start": 38751,
          "end": 39531,
          "span_sha256": "6530eff5f07d6b205d74500e9eb55ad736262a9a4b823a0d686a225674261b35",
          "line_start": 440,
          "line_end": 446,
