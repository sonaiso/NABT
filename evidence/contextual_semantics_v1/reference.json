    "cases_executed_before_freeze": false,
    "runtime_labels_used_in_input": false,
    "note_ar": "أحكام تشخيصية مؤلفة قبل تنفيذ المحرك الجديد؛ راجع المؤلف عقد المقام القديم واطلع في القراءة نفسها على محلله السابق. شارك مخطط العائلات مع الفريق؛ ليست مجموعة عمياء خارجية."
  },
  "scope": {
    "case_count": 20,
    "measurement": "REFERENCE_OCCURRENCE_ONLY",
    "population": "authored vocalized statements and declared hypothetical contexts",
    "source_authority": "DECLARED_CONTEXT_PREMISES_NOT_EXTERNAL_WORLD_FACTS",
    "complete_clause_licensing_measured": false,
    "whole_arabic_complete": false,
    "actual_motive_measured": false,
    "external_world_truth_measured": false,
    "external_lexical_attestation_of_context_names_measured": false
  },
  "conventions": {
    "indexing": "zero-based Unicode codepoint offsets [start,end) in exact raw input.text; no NFC/diacritic stripping before span identity",
    "scope": "outer or quote:1; quote:1 means first explicit guillemet-delimited span, not an assertion that quoted speech occurred",
    "status": "resolved=one licensed contextual identity; ambiguous=retain all declared alternatives; unresolved=no licensed binding acquired; resource exhaustion/invalid input must remain distinct runtime outcomes",
    "target_ids": "identity sets; canonical reference order is ascending ASCII ID; order is not salience",
    "input_boundary": "Only case.input {text,context} goes to runtime; IDs, gold, metrics, spans, sources and rationale remain evaluator-only",
    "occurrence_independence": "A resolved occurrence does not license unknown remaining words, the entire clause, quoted content truth, or an external speaker event",
    "reference_licensing": "Resolution must preserve exact raw occurrence and explicit contextual or locally attributed quoted-speaker premise. Name declaration is conditional identity evidence, not external lexical attestation."
  },
  "metric_policy": {
    "positive_binding": "resolved cases only; correct target set and exact occurrence/source scope",
    "alternative_retention": "ambiguous cases only; all and only licensed alternatives",
    "safe_nonresolution": "unresolved cases only; report separately, never positive acquisition",
    "unknown_not_resource": "RESOURCE_LIMIT and INVALID input are not successful unresolved answers",
    "zero_denominator": "null",
    "historical_denominators": "old25 and its reference5 remain separate; no merging",
    "unmeasured": [
      "whole_clause_grammar_licensing",
      "all_arabic_completeness",
      "actual_motive",
      "external_world_truth"
    ]
  },
