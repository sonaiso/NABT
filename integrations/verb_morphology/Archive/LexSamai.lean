theorem taf_total : tafRows.length = 609 := by decide +kernel
theorem naqis_all_tafila :
    count (fun r => r.2.1 == .naqis) = 29 ∧ count (fun r => r.2.1 == .naqis && r.2.2 == .tafila) = 29 := by
  decide +kernel
theorem mahmuz_split :
    count (fun r => r.2.1 == .mahmuz && r.2.2 == .tafila) = 7 ∧
    count (fun r => r.2.1 == .mahmuz && r.2.2 == .tafil) = 1 := by decide +kernel
theorem salim_split :
    count (fun r => r.2.1 == .salim && r.2.2 == .tafil) = 566 ∧
    count (fun r => r.2.1 == .salim && r.2.2 == .tafila) = 6 := by decide +kernel
theorem W_hits : count (fun r => W r.2.1 == r.2.2) = 602 := by decide +kernel


