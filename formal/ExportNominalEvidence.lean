import Nabt.NominalEvidence
import Lean

/-! Finite conditional tables generated by Lean definitions. These are not a
dictionary of nouns, an attested-root inventory, or a contextual case parser. -/

open Lean Nabt.NominalEvidence

def bit (n i : Nat) : Bool := n / 2 ^ i % 2 == 1

def nominalEvidenceJson : Json := Json.mkObj [
  ("schema_version", toJson (1 : Nat)),
  ("law_id", toJson lawId),
  ("number_domains", Json.mkObj [
    ("profile", toJson "nabt.nominal-evidence.profile24.v1"),
    ("constraint", toJson "nabt.nominal-evidence.constraint11.v1"),
    ("receipt_mask", toJson "nabt.nominal-evidence.activation7.v1"),
    ("weak_mask", toJson "nabt.nominal-evidence.weak-position3.v1"),
    ("manqus_mask", toJson "nabt.nominal-evidence.manqus5.v1")]),
  ("profile_rows", toJson (profiles.map fun p => Json.mkObj [
    ("code", toJson p.code), ("gender", toJson p.gender.val),
    ("form", toJson p.form.val), ("definiteness", toJson p.definiteness.val),
    ("number", toJson p.number),
    ("accepts", toJson (constraints.map fun c => c.accepts p))])),
  ("receipt_bits", toJson ["source_match", "scope_match", "occurrence_match", "reading_match", "active", "blocked", "noun_domain"]),
  ("receipt_rows", toJson ((List.range 128).map fun n => Json.mkObj [
    ("mask", toJson n), ("activated", toJson (activation (bit n 0) (bit n 1)
      (bit n 2) (bit n 3) (bit n 4) (bit n 5) (bit n 6)))])),
  ("numeral_rows", toJson (Cardinal.quantities.flatMap fun q =>
    (List.finRange 2).map fun g =>
      let r := Cardinal.body q g
      Json.mkObj [
        ("quantity", toJson q), ("singular_gender", toJson g.val),
        ("counted_number", toJson r.countedNumber),
        ("counted_case", toJson r.countedCase.label),
        ("unit_gender", toJson (r.unitGender.map Fin.val)),
        ("ten_gender", toJson (r.tenGender.map Fin.val))])),
  ("weak_rows", toJson ((List.range 8).map fun n =>
    let m : Weak.Mask := ⟨bit n 0, bit n 1, bit n 2⟩
    Json.mkObj [("mask", toJson m.code), ("class", toJson (Weak.classify m).label)])),
  ("manqus_bits", toJson ["noun", "inflected", "necessary_final_yaa", "preceding_kasra", "final_yaa_unshaddad"]),
  ("manqus_rows", toJson ((List.range 32).map fun n =>
    let f : Manqus.Features := ⟨bit n 0, bit n 1, bit n 2, bit n 3, bit n 4⟩
    Json.mkObj [("mask", toJson f.code), ("accepted", toJson f.accepted)])),
  ("pronoun_source_kind", toJson "NEW_UNICODE_PROJECTION"),
  ("pronoun_source_contract", toJson "Jisr.QiraaSimat.damairKhalaya"),
  ("pronoun_source_pin", toJson "e4c801ffe9171dadedcc3aae23051ea0953ae361"),
  ("pronoun_gender2", toJson "unspecified_in_projection_shared_in_upstream"),
  ("pronoun_rows", toJson (pronounRows.map fun p => Json.mkObj [
    ("surface", toJson p.surface), ("person", toJson p.person),
    ("gender", toJson p.gender), ("number", toJson p.number)])),
  ("scope", toJson "QUALIFIED_NOMINAL_CANDIDATES_NOT_LEXICAL_INFERENCE_CASE_ROLE_OR_WORLD_FACTS"),
  ("numeral_scope", toJson "CARDINAL_1_TO_99_100_1000_WITH_WITNESSED_SINGULAR_GENDER"),
  ("weak_scope", toJson "SUPPLIED_CANONICAL_ROOT_W_Y_POSITIONS_NOT_ATTESTATION_OR_ILAL"),
  ("pronoun_scope", toJson "NEW_UNICODE_PROJECTION_NOT_PROVED_A116_OR_PARTIAL_MARK_READER_EQUIVALENCE")
]

def main : IO Unit := IO.println nominalEvidenceJson.compress
