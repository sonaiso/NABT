/-- كلُّ ضلعٍ في الشجرة له سندٌ، وكلُّ سندٍ ضلعٌ فيها. -/
theorem adlaa_bi_asanid :
    [mukhassas, lisan, maqayis, taj].all (fun b =>
      ((shajara b).getD []).all (fun s => asanid.any (fun a => a.kitab == b && a.masdar == s))) = true ∧
    asanid.all (fun a => ((shajara a.kitab).getD []).contains a.masdar) = true := by decide

/-! ## ٣. النتيجة -/

/-- الوقود: عمقُ الشجرة المقروءة اثنان (التاج ← اللسان ← المحكم)؛ وثلاثةٌ تكفي. -/
def waqud : Nat := 3

theorem natija :
    istiqlal shajara waqud maqayis mukhassas = .ghayr ∧
    istiqlal shajara waqud taj lisan = .ghayr ∧
    istiqlal shajara waqud taj mukhassas = .ghayr ∧
    istiqlal shajara waqud taj maqayis = .ghayr ∧
    istiqlal shajara waqud lisan mukhassas = .laHukm ∧
    istiqlal shajara waqud lisan maqayis = .laHukm := by decide

/-- **المعاجمُ الأربعةُ المختومة شاهدٌ واحدٌ بعدّ الشجرة**، وأربعةٌ بعدّ السجلّ. -/
theorem adad_arbaa :
    adadS shajara waqud [mukhassas, lisan, maqayis, taj] = 1 ∧
    adad [⟨1, "mukhassas"⟩, ⟨2, "lisan"⟩, ⟨3, "maqayis"⟩, ⟨4, "taj"⟩] = 4 := by decide

/-- **الشهودُ الثلاثة في شاهد Muallij** تُقبل بالسجلّ (`NTP.yuqbal`) ولا تُقبل بالشجرة عند K = 2. -/
theorem zayt_bi_sijill_la_bi_shajara :
    yuqbal 2 (shabakaShahid.shuhud nZayt) = true ∧
    Silsila.yuqbalS 2 shajara waqud (shabakaShahid.shuhud nZayt) = false := by decide

