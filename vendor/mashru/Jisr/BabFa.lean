/-! ## مبرهنات (خواصُّ التعيين على مجاله؛ والضابطُ يشهد أنّه غيرُ فارغ: `Jisr/BabFaQiyas.lean`) -/

/-- **الدرجاتُ لا تخلو** (لكلّ؛ برهانُها بالاستنفاد: `decide` على كلّ مدخل): لكلّ مدخلٍ درجةٌ في الكلام على الأقلّ (و«لا حكم» درجة). -/
theorem kalam_ghayr_farigh (j : Jumla) : kalam j ≠ [] := by
  rcases j with ⟨s, m, i⟩
  cases s <;> cases m <;> cases i <;> decide

/-- **لا نصبَ مقبولًا في الكلام في الواجب** (لكلّ؛ بالاستنفاد): «ولا يكون في هذا الباب إلا الرفع» و«وهو ضعيف في الكلام». -/
theorem wajib_la_nasb (m : Mana) : ¬ (kalam ⟨.wajib, m, .nasb⟩).contains .maqbul := by
  cases m <;> decide

/-- **ولا جزمَ بعد الأمر** (لكلّ؛ بالاستنفاد): «ولا سبيل ههنا إلى الجزم». -/
theorem amr_la_jazm (m : Mana) : kalam ⟨.amr, m, .jazm⟩ = [.khata] := by
  cases m <;> decide

/-- **النصبُ للسبب مقبولٌ في كلّ صدرٍ غيرِ واجب** إلّا الظنَّ (بديلان) (تعريفيّة؛ وكان قبل قراءة الحالات بلا استثناء). -/
theorem nasb_ghayr_wajib (s : Sadr) (h : wajib s = false) (hz : s ≠ .zann) :
    kalam ⟨s, .sabab, .nasb⟩ = [.maqbul] := by
  cases s <;> simp_all [wajib, kalam, kalamMuallan, nasbSabab]

/-- **ما قُبل في الكلام قُبل في الشعر** (تعريفيّة). -/
theorem maqbul_kalam_maqbul_shir (j : Jumla) (h : (kalam j).contains .maqbul) : shir j = [.maqbul] := by
  unfold shir
  simp only [h, ↓reduceIte]

/-- **الإيجابُ يفرّق** (على الشاهد): النصبُ للسبب مقبولٌ في النفي بـ«ما» وضعيفٌ في الواجب، ومقبولٌ في شعر الاثنين. -/
theorem ijab_yufarriq :
    hukm ⟨.nafyMaMudari, .sabab, .nasb⟩ = ⟨[.maqbul], [.maqbul]⟩ ∧
    hukm ⟨.wajib, .sabab, .nasb⟩ = ⟨[.daif], [.maqbul]⟩ := by
  decide

/-- **بديلان** (على الشاهد): الظنُّ نصبًا بلا معنًى معلَن، والنفيُ بـ«لا» شركةً رفعًا. -/
theorem ghamid_shawahid :
    kalam ⟨.zann, .ghayrMuallan, .nasb⟩ = [.maqbul, .khata] ∧
    kalam ⟨.nafyLa, .shirka, .raf⟩ = [.maqbul, .qabih] ∧
    ghamid ⟨.zann, .ghayrMuallan, .nasb⟩ = true := by
  decide

/-- **ما غُيّر بعد قراءة الحالات** (على الشاهد، على ثمانية مدخلاتٍ بأعيانها): النهيُ قطعًا رفعًا مقبول، والاستفهامُ سببًا رفعًا مقبول،
    والدعاءُ قطعًا رفعًا «لا حكم» في الكلام مقبولٌ في الشعر، والتمنّي والواجبُ بمعنًى غيرِ معلَنٍ جزمًا خطأ، والظنُّ سببًا نصبًا بديلان، والتمنّي
    و«ما» والماضي شركةً رفعًا بديلان. -/
theorem baad_qiraa :
    kalam ⟨.nahy, .qat, .raf⟩ = [.maqbul] ∧ kalam ⟨.istifham, .sabab, .raf⟩ = [.maqbul] ∧
    hukm ⟨.dua, .qat, .raf⟩ = ⟨[.laHukm], [.maqbul]⟩ ∧ kalam ⟨.tamanni, .ghayrMuallan, .jazm⟩ = [.khata] ∧
    kalam ⟨.wajib, .ghayrMuallan, .jazm⟩ = [.khata] ∧ kalam ⟨.zann, .sabab, .nasb⟩ = [.maqbul, .khata] ∧
    kalam ⟨.tamanni, .shirka, .raf⟩ = [.maqbul, .khata] ∧ kalam ⟨.nafyMaMadi, .shirka, .raf⟩ = [.maqbul, .daif] := by
  decide

end BabFa
end Jisr
